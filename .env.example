# ============================================================
# AdvoAI Backend — Environment Variables (.env.example)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────
# Works with both local PostgreSQL and Neon.
# Local:  postgresql://user:password@localhost:5432/advoai
# Neon:   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/advoai?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/advoai

# ── Google AI (Gemini) ───────────────────────────────────────
# Use GOOGLE_API_KEY for a single key, or GOOGLE_API_KEYS for a comma-separated list of keys (for load balancing).
GOOGLE_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEYS=key1,key2,key3

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://advoai.uz

# ── JWT Auth ─────────────────────────────────────────────────
# REQUIRED: The app will fail to start if this is left as a placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_your_secure_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Note: Ensure Authorized JavaScript origins includes your frontend URLs.
GOOGLE_CLIENT_ID=230153605758-uc18m93vif8ah4e02a735jj4o28gvhcn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ── Email / Resend ───────────────────────────────────────────
# If omitted, emails (like OTPs) will be logged to the console instead.
RESEND_API_KEY=
EMAILS_FROM_EMAIL=noreply@advoai.uz
EMAILS_FROM_NAME="AdvoAI Security"

# ── S3 / Cloudflare R2 Storage (For Attachments) ─────────────
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Usage Limits ─────────────────────────────────────────────
GUEST_MESSAGE_LIMIT=3
FREE_DAILY_LIMIT=20