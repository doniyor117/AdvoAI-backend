# ============================================================
# AdvoAI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Works with both local PostgreSQL and Neon.
# Local:  postgresql://user:password@localhost:5432/advoai
# Neon:   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/advoai?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/advoai

# ── Google AI (Gemini) ───────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com

# ── JWT Auth ─────────────────────────────────────────────────
# REQUIRED: The app will fail to start if this is left as a placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_your_secure_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Usage Limits ─────────────────────────────────────────────
GUEST_MESSAGE_LIMIT=3
FREE_DAILY_LIMIT=20
