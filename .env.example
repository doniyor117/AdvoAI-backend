# ============================================================
# Project Basira — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Works with both local PostgreSQL and Neon.
# Local:  postgresql://user:password@localhost:5432/basira
# Neon:   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/basira?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/basira

# ── Google AI (Gemini) ───────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=development

# ── Feature Toggles ──────────────────────────────────────────
# If True, enables Cross-Encoder reranking (high accuracy, slower CPU inference)
# If False, relies solely on fast pgvector cosine similarity
USE_RERANKER=False

