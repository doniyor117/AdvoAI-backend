# ============================================================
# Yurika — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Works with both local PostgreSQL and Neon.
# Local:  postgresql://user:password@localhost:5432/yurika
# Neon:   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/yurika?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/yurika

# ── Google AI (Gemini) ───────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here

# ── App Settings ─────────────────────────────────────────────
ENVIRONMENT=development

# ── Feature Toggles ──────────────────────────────────────────
# If True, enables Cross-Encoder reranking (high accuracy, slower CPU inference)
# If False, relies solely on fast pgvector cosine similarity
USE_RERANKER=False

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Usage Limits ─────────────────────────────────────────────
GUEST_MESSAGE_LIMIT=3
FREE_DAILY_LIMIT=20


